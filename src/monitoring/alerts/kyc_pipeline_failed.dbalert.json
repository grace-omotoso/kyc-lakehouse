{
  "evaluation": {
    "source": {
      "name": "failed_updates_24h",
      "display": "failed_updates_24h",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
