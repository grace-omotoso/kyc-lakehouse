  },
  "query_lines": [
    "SELECT COUNT(*) AS failed_updates_24h",
    "FROM dev_kyc.ops.pipeline_updates",
    "WHERE state = 'FAILED'",
    "  AND finished_at >= current_timestamp() - INTERVAL 1 DAY;"
  ]
}
