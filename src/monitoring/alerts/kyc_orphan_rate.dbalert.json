{
  "evaluation": {
    "source": {
      "name": "orphan_pct",
      "display": "orphan_pct",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 10.0
      }
    },
    "notification": {}
  },
  "query_lines": [
    "SELECT ROUND(100.0 * orphan_txns / NULLIF(fact_txns, 0), 2) AS orphan_pct",
    "FROM dev_kyc.ops.run_log",
    "ORDER BY run_ts DESC",
    "LIMIT 1;"
  ]
}
